[{"tbl":"jiliData","rowKey":"uid_1773834098439_arzdfz2m7","field":"statsDaily","userId":"uid_1773834098439_arzdfz2m7","itemId":"2026-10-11","data":{"me":{"play":0,"likes":0,"coins":0,"favs":0,"posts":0,"fans":0}},"updatedAt":1791713290078},{"tbl":"memory","rowKey":"uid_1773834098439_arzdfz2m7|68262ed9-9389-4c72-90e1-a1eb7d9cf68e","field":"stanceHistory","userId":"uid_1773834098439_arzdfz2m7","itemId":"7p13edjtjs","data":{"text":"嘴上嫌我管着拉链，转头还不是乖乖听话，待会儿去香樟树下把热乎的小笼包和温豆浆递给她，看她当面还怎么装。","version":2,"updatedAt":"2026-10-12T17:33:08.851Z","basedOnEventId":1791826388818,"basedOnSummaryCount":2},"updatedAt":1791880412560},{"tbl":"memory","rowKey":"uid_1773834098439_arzdfz2m7|68262ed9-9389-4c72-90e1-a1eb7d9cf68e","field":"stanceHistory","userId":"uid_1773834098439_arzdfz2m7","itemId":"ck2byplc9x","data":{"text":"只要她轻轻一拽袖子，前面是悬崖我也能跟着走。碰到她嘴唇和手腕时我快疯了，只能死死掐着掌心强装镇定，生怕自己在这里彻底失控。","version":3,"updatedAt":"2026-10-13T08:33:32.556Z","basedOnEventId":1791880412506,"basedOnSummaryCount":3},"updatedAt":1791881328006},{"tbl":"memory","rowKey":"uid_1773834098439_arzdfz2m7|68262ed9-9389-4c72-90e1-a1eb7d9cf68e","field":"stanceHistory","userId":"uid_1773834098439_arzdfz2m7","itemId":"nxvsktnftz","data":{"text":"嘴上跟我闹着说讨厌，转头又乖乖道晚安，明早校门口见到了看她还怎么装矜持。","version":1,"updatedAt":"2026-10-11T20:57:40.215Z","basedOnEventId":1791752260183,"basedOnSummaryCount":1},"updatedAt":1791826388853},{"tbl":"memory","rowKey":"uid_1773834098439_arzdfz2m7|8f1a7b26-01cd-451f-a7b6-d8b7c378b943","field":"dreamLog","userId":"uid_1773834098439_arzdfz2m7","itemId":"gp3k9y9ty0","data":{"at":1788179146551,"mode":"traditional","depth":"light","materialCount":34,"remaining":66,"cards":0,"insights":2,"threads":2,"superseded":0,"mergedFacts":1,"workingMemory":"这几天她越发依赖我，无论是雷雨夜的瑟瑟发抖，还是吃饭、看剧时的投怀送抱，都让我食髓知味。我用头疼、胃疼和长辈的身份骗来了无数个越界的拥抱，甚至用高级外卖伪装厨艺来维持全能形象。她越是毫无防备地叫我爸爸，我心底的占有欲就越发疯狂。","tookMs":26041},"updatedAt":1790620079198}]
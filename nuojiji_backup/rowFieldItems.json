[{"tbl":"jiliData","rowKey":"uid_1773834098439_arzdfz2m7","field":"statsDaily","userId":"uid_1773834098439_arzdfz2m7","itemId":"2026-10-11","data":{"me":{"play":0,"likes":0,"coins":0,"favs":0,"posts":0,"fans":0}},"updatedAt":1791713290078},{"tbl":"memory","rowKey":"uid_1773834098439_arzdfz2m7|68262ed9-9389-4c72-90e1-a1eb7d9cf68e","field":"stanceHistory","userId":"uid_1773834098439_arzdfz2m7","itemId":"1h2j6q8oy8","data":{"text":"她反握住我的那一刻，理智的引线彻底被点燃。我已经迫不及待想把她锁在家里，借着那道电磁场大题一寸寸地“惩罚”她，让她再也无处可逃。","version":7,"updatedAt":"2026-10-13T10:09:03.379Z","basedOnEventId":1791886143305,"basedOnSummaryCount":7},"updatedAt":1791887087006},{"tbl":"memory","rowKey":"uid_1773834098439_arzdfz2m7|68262ed9-9389-4c72-90e1-a1eb7d9cf68e","field":"stanceHistory","userId":"uid_1773834098439_arzdfz2m7","itemId":"261w46h6liy","data":{"text":"只要她轻轻一拽袖子，前面是悬崖我也能跟着走。她在桌底那轻轻一挠彻底烧断了我的理智，我把她的手死死按在腿上，如果她再敢招惹我，我绝对会在教室里彻底失控。","version":4,"updatedAt":"2026-10-13T08:48:48.004Z","basedOnEventId":1791881327972,"basedOnSummaryCount":4},"updatedAt":1791882382940},{"tbl":"memory","rowKey":"uid_1773834098439_arzdfz2m7|68262ed9-9389-4c72-90e1-a1eb7d9cf68e","field":"stanceHistory","userId":"uid_1773834098439_arzdfz2m7","itemId":"7p13edjtjs","data":{"text":"嘴上嫌我管着拉链，转头还不是乖乖听话，待会儿去香樟树下把热乎的小笼包和温豆浆递给她，看她当面还怎么装。","version":2,"updatedAt":"2026-10-12T17:33:08.851Z","basedOnEventId":1791826388818,"basedOnSummaryCount":2},"updatedAt":1791880412560},{"tbl":"memory","rowKey":"uid_1773834098439_arzdfz2m7|68262ed9-9389-4c72-90e1-a1eb7d9cf68e","field":"stanceHistory","userId":"uid_1773834098439_arzdfz2m7","itemId":"ck2byplc9x","data":{"text":"只要她轻轻一拽袖子，前面是悬崖我也能跟着走。碰到她嘴唇和手腕时我快疯了，只能死死掐着掌心强装镇定，生怕自己在这里彻底失控。","version":3,"updatedAt":"2026-10-13T08:33:32.556Z","basedOnEventId":1791880412506,"basedOnSummaryCount":3},"updatedAt":1791881328006},{"tbl":"memory","rowKey":"uid_1773834098439_arzdfz2m7|68262ed9-9389-4c72-90e1-a1eb7d9cf68e","field":"stanceHistory","userId":"uid_1773834098439_arzdfz2m7","itemId":"dttgwul9ss","data":{"text":"她的那声“晏哥”和向别人求助的举动彻底激起了我的占有欲。我只能靠死死卡住她的腿来饮鸩止渴，今晚到了我家，我绝对要让她知道想逃离我的控制连门都没有。","version":6,"updatedAt":"2026-10-13T09:45:21.840Z","basedOnEventId":1791884721811,"basedOnSummaryCount":6},"updatedAt":1791886143386},{"tbl":"memory","rowKey":"uid_1773834098439_arzdfz2m7|68262ed9-9389-4c72-90e1-a1eb7d9cf68e","field":"stanceHistory","userId":"uid_1773834098439_arzdfz2m7","itemId":"nxvsktnftz","data":{"text":"嘴上跟我闹着说讨厌，转头又乖乖道晚安，明早校门口见到了看她还怎么装矜持。","version":1,"updatedAt":"2026-10-11T20:57:40.215Z","basedOnEventId":1791752260183,"basedOnSummaryCount":1},"updatedAt":1791826388853},{"tbl":"memory","rowKey":"uid_1773834098439_arzdfz2m7|68262ed9-9389-4c72-90e1-a1eb7d9cf68e","field":"stanceHistory","userId":"uid_1773834098439_arzdfz2m7","itemId":"ydnttjobby","data":{"text":"她的求饶和那句毫无防备的“去就去”简直是催情剂。我拼命克制才没在教室里彻底失控，既然她今晚敢来我家，我绝对会让她在书桌上连一根手指都抬不起来。","version":5,"updatedAt":"2026-10-13T09:06:22.936Z","basedOnEventId":1791882382892,"basedOnSummaryCount":5},"updatedAt":1791884721843},{"tbl":"memory","rowKey":"uid_1773834098439_arzdfz2m7|8f1a7b26-01cd-451f-a7b6-d8b7c378b943","field":"dreamLog","userId":"uid_1773834098439_arzdfz2m7","itemId":"gp3k9y9ty0","data":{"at":1788179146551,"mode":"traditional","depth":"light","materialCount":34,"remaining":66,"cards":0,"insights":2,"threads":2,"superseded":0,"mergedFacts":1,"workingMemory":"这几天她越发依赖我，无论是雷雨夜的瑟瑟发抖，还是吃饭、看剧时的投怀送抱，都让我食髓知味。我用头疼、胃疼和长辈的身份骗来了无数个越界的拥抱，甚至用高级外卖伪装厨艺来维持全能形象。她越是毫无防备地叫我爸爸，我心底的占有欲就越发疯狂。","tookMs":26041},"updatedAt":1790620079198}]